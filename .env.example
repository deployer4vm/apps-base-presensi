APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://absensi.example.com
APP_TIMEZONE=Asia/Jakarta

MIX_APP_ENV=production

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=

DB_CONNECTION_PERTENANT=mysql
DB_HOST_PERTENANT=localhost
DB_PORT_PERTENANT=3306
DB_DATABASE_PERTENANT=homestead
DB_USERNAME_PERTENANT=homestead
DB_PASSWORD_PERTENANT=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=https://absensi.example.com

REDIS_HOST=localhost
REDIS_PASSWORD=null
REDIS_PORT=6379

TELESCOPE_ENABLED=false

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

S3_MULTISERVER_ENABLE=false

S3_MULTISERVER_1_ACCESS_KEY_ID=
S3_MULTISERVER_1_SECRET_ACCESS_KEY=
S3_MULTISERVER_1_DEFAULT_REGION=us-east-1
S3_MULTISERVER_1_BUCKET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

LARAVEL_WEBSOCKETS_HOST=localhost
LARAVEL_WEBSOCKETS_PORT=6001
LARAVEL_WEBSOCKETS_SCHEME=http
LARAVEL_WEBSOCKETS_SSL=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=/absolute/path/outside-public-webroot/firebase.json
ETASK_BASE_URL=https://laporan.4visionmedia.com/api

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.2.5",
        "beberlei/doctrineextensions": "^1.2",
        "beyondcode/laravel-websockets": "^1.4",
        "box/spout": "^3.3",
        "dompdf/dompdf": "^2.0",
        "endroid/qr-code": "^3.7",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^1.0",
        "guzzlehttp/guzzle": "^6.3",
        "hp-synapse/mod-user": "dev-master",
        "hp-synapse/apps-manager": "dev-master",
        "laravel/framework": "^7.0",
        "laravel/telescope": "^3.5",
        "laravel/tinker": "^2.0",
        "league/flysystem-aws-s3-v3": "~1.0",
        "league/flysystem-cached-adapter": "~1.0",
        "league/flysystem-sftp": "~1.0",
        "madnest/madzipper": "^1.0",
        "phpoffice/phpspreadsheet": "^1.8",
        "pusher/pusher-php-server": "~4.0",
        "ramsey/uuid": "^4.1"
    },
    "require-dev": {
        "facade/ignition": "^2.0",
        "fzaninotto/faker": "^1.9.1",
        "hp-synapse/apps-generator": "dev-master",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^4.1",
        "orangehill/iseed": "^2.6",
        "phpunit/phpunit": "^8.5",
        "reliese/laravel": "^0.0.14"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": [
        {
            "name": "hp-synapse/apps-generator",
            "type": "path",
            "url": "../../apps-generator",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "hp-synapse/apps-manager",
            "type": "path",
            "url": "../../apps-manager",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "hp-synapse/mod-accounting",
            "type": "path",
            "url": "../../mod-accounting",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "hp-synapse/mod-coop",
            "type": "path",
            "url": "../../mod-coop",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "hp-synapse/mod-coop-sp",
            "type": "path",
            "url": "../../mod-coop-sp",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "hp-synapse/mod-cp",
            "type": "path",
            "url": "../../mod-cp",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "hp-synapse/mod-digitalpayment",
            "type": "path",
            "url": "../../mod-digitalpayment",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "hp-synapse/mod-ppob",
            "type": "path",
            "url": "../../mod-ppob",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "hp-synapse/mod-sewa",
            "type": "path",
            "url": "../../mod-sewa",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "hp-synapse/mod-user",
            "type": "path",
            "url": "../../mod-user",
            "options": {
                "symlink": true
            }
        }
    ]
}

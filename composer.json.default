{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0.2",
        "beberlei/doctrineextensions": "^1.3",
        "beyondcode/laravel-websockets": "^1.13",
        "box/spout": "^3.3",
        "dompdf/dompdf": "^2.0",
        "endroid/qr-code": "^4.7",
        "fruitcake/laravel-cors": "^3.0",
        "guzzlehttp/guzzle": "^7.2",
        "hp-synapse/mod-user": "dev-master",
        "hp-synapse/apps-manager": "dev-master",
        "laravel/framework": "^9.0",
        "laravel/telescope": "^4.0",
        "laravel/sanctum": "^3.0",
        "laravel/tinker": "^2.7",
        "laravel/ui": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-sftp-v3": "^3.0",
        "madnest/madzipper": "^1.3",
        "phpoffice/phpspreadsheet": "^1.26",
        "pusher/pusher-php-server": "~5.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "spatie/laravel-ignition": "^1.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.0",
        "hp-synapse/apps-generator": "dev-master",
        "mockery/mockery": "^1.4",
        "nunomaduro/collision": "^6.1",
        "orangehill/iseed": "^3.0",
        "phpunit/phpunit": "^9.5",
        "reliese/laravel": "^1.1"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": [
        {
            "name": "hp-synapse/apps-generator",
            "type": "path",
            "url": "../apps-generator",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "hp-synapse/apps-manager",
            "type": "path",
            "url": "../apps-manager",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "hp-synapse/mod-user",
            "type": "git",
            "url": "https://gitlab.com/hp-synapse/mod-user.git"
        }
    ]
}
